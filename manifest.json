{
  "manifest_version": 3,
  "name": "ChatGPT & Gemini Conversation Toolkit",
  "version": "1.0.0",
  "description": "Chrome extension for ChatGPT and Gemini: long-chat optimization, JSON export, previous/next user-turn jump, and bulk conversation delete.",
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "image/icon.jpg",
        "gemini-icon.png"
      ],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ]
    }
  ]
}
